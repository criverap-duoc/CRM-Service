# Forzar LF en scripts que corren en Linux (Docker/Render).
# Sin esto, core.autocrlf=true en Windows convierte el entrypoint.sh
# a CRLF y rompe con "bash: \r: command not found" dentro del
# contenedor.
*.sh text eol=lf

# Normalizar archivos de texto a LF en el repo
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binarios: sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Modelos ML (joblib): binarios
*.pkl binary

# Copia este archivo a .env.docker y ajusta los valores.
# El archivo .env.docker está en .gitignore.

# Django
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
DB_NAME=crm_service
DB_USER=crm_user
DB_PASSWORD=change-me-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Integraciones (opcionales)
OPENAI_API_KEY=
META_ACCESS_TOKEN=
META_APP_SECRET=
